{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app44",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "224dd714-1dd8-4819-9cd6-8cfb4fb203e6","database_name": "web-app44" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1d6eb7c6401d475b98fd30cab12db418" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
